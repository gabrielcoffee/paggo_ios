{
  "extends": "@paggo/tsconfig/nextjs.json",
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "downlevelIteration": true,
    "moduleResolution": "bundler",
    "paths": {
      "@paggo/ui/atoms/*": ["../../packages/paggo-ui/components/atoms/*/index"],
      "@paggo/ui/molecules/*": ["../../packages/paggo-ui/components/molecules/*/index"],
      "@paggo/ui/organisms/*": ["../../packages/paggo-ui/components/organisms/*/index"],
      "@paggo/ui/hooks": ["../../packages/paggo-ui/hooks/index"],
      "@paggo/ui/hooks/*": ["../../packages/paggo-ui/hooks/*"],
      "@paggo/ui/hocs": ["../../packages/paggo-ui/hocs/index"],
      "@paggo/ui/hocs/*": ["../../packages/paggo-ui/hocs/*"],
      "@paggo/ui/utils": ["../../packages/paggo-ui/utils/index"],
      "@paggo/ui/utils/*": ["../../packages/paggo-ui/utils/*"],
      "@paggo/ui/illustrations": ["../../packages/paggo-ui/illustrations/index"],
      "@paggo/ui/illustrations/*": ["../../packages/paggo-ui/illustrations/*"],
      "@paggo/ui/fonts": ["../../packages/paggo-ui/fonts/index"],
      "@paggo/ui/fonts/*": ["../../packages/paggo-ui/fonts/*"],
      "@paggo/ui/legacy": ["../../packages/paggo-ui/legacy/index"],
      "@paggo/ui/legacy/*": ["../../packages/paggo-ui/legacy/*"],
      "@paggo/ui/components": ["../../packages/paggo-ui/components/index"],
      "@paggo/ui/components/*": ["../../packages/paggo-ui/components/*"],
      "@components": ["./src/components"],
      "@components/*": ["./src/components/*"],
      "@config": ["./src/config"],
      "@config/*": ["./src/config/*"],
      "@contexts": ["./src/contexts"],
      "@contexts/*": ["./src/contexts/*"],
      "@hooks": ["./src/hooks"],
      "@hooks/*": ["./src/hooks/*"],
      "@modules": ["./src/modules"],
      "@modules/*": ["./src/modules/*"],
      "@providers": ["./src/providers"],
      "@providers/*": ["./src/providers/*"],
      "@styles": ["./src/styles"],
      "@styles/*": ["./src/styles/*"],
      "@stores": ["./src/stores"],
      "@stores/*": ["./src/stores/*"],
      "@utils": ["./src/utils"],
      "@utils/*": ["./src/utils/*"],
      "@/*": ["./src/*"],
      "react": ["./node_modules/@types/react"]
    }
  }
}
